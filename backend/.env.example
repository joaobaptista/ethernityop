# =========================================================
# Ethernity DMS - Backend Environment Configuration Example
# =========================================================

PORT=3333
SECONDARY_PORT=8000
NODE_ENV=development
CLIENT_URL=http://localhost:5173,http://localhost:5174,http://localhost:5175
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3333

# Obrigatório em produção (NODE_ENV=production). Use um valor longo e aleatório.
JWT_SECRET=troque-por-um-segredo-aleatorio
# E-mails extras de administradores raiz (separados por vírgula)
ADMIN_EMAILS=
# Opt-in explícito para senhas demo e pagamentos simulados em produção (padrão: desligado)
ENABLE_DEMO_LOGIN=0
ENABLE_PAYMENT_SIMULATION=0
JWT_EXPIRES_IN=7d
MEDIA_URL_EXPIRES_IN=5m

UPLOAD_FOLDER=./uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=ethernity
DATABASE_USER=root
DATABASE_PASSWORD=

GOOGLE_PHOTOS_CLIENT_ID=553558864113-veta0pst9uks8215qb7fuvodnjrq6sgc.apps.googleusercontent.com
GOOGLE_PHOTOS_CLIENT_SECRET=seu-client-secret-do-google
GOOGLE_PHOTOS_REDIRECT_URI=http://localhost:3333/api/integrations/google-photos/callback
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_PHOTOS_TOKEN_ENCRYPTION_KEY=
GOOGLE_PHOTOS_STATE_TTL_SECONDS=600
GOOGLE_PHOTOS_MAX_FILE_SIZE_MB=50
GOOGLE_PHOTOS_MAX_ITEMS_PER_SESSION=50

GOOGLE_CLIENT_ID=553558864113-veta0pst9uks8215qb7fuvodnjrq6sgc.apps.googleusercontent.com
GOOGLE_REDIRECT_URI=http://localhost:3333/api/integrations/google-photos/callback

TELEMETRY_ENABLED=0
GEOFENCING_API_KEY=geofencing-service-key-2024